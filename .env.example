# Docker Compose ports
FRONTEND_PORT=8080
BACKEND_PORT=8081

# Backend security
SECURITY_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SECURITY_OTP_DEV_RETURN=true

# Optional owner-admin bootstrap. Leave blank unless you need this behavior.
DEMO_OWNER_ADMIN_EMAIL=
DEMO_OWNER_ADMIN_PHONE=

# OTP delivery. Keep disabled for local dev unless credentials are configured.
OTP_DELIVERY_EMAIL_ENABLED=false
OTP_DELIVERY_SMS_ENABLED=false
OTP_DELIVERY_EMAIL_FROM=no-reply@snap-eats.local
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
OTP_DELIVERY_SMS_WEBHOOK_URL=
OTP_DELIVERY_SMS_AUTH_TOKEN=
